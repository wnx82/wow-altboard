{
  "name": "wow-altboard-web",
  "version": "0.16.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --env-file-if-exists=.env.local --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local src/db/migrate.ts",
    "db:migrate:test": "tsx --env-file-if-exists=.env.local src/db/migrate.ts --test",
    "token:create": "tsx --env-file-if-exists=.env.local scripts/create-agent-token.ts",
    "admin:create": "tsx --env-file-if-exists=.env.local scripts/create-admin.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "exceljs": "^4.4.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "type": "module"
}
